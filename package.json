{
  "name": "password",
  "version": "3.0.0",
  "description": "Hash based password manager",
  "scripts": {
    "lint": "npm run lint:format && npm run lint:js",
    "lint:js": "eslint",
    "lint:format": "prettier . --check",
    "format": "prettier . --write",
    "start": "npx http-server src -c-1",
    "predeploy": "npm run lint",
    "deploy": "npx gh-pages -d src"
  },
  "author": "danieldevlewis",
  "license": "ISC",
  "prettier": {
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  }
}
